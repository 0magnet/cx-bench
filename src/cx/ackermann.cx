package main

// Ackermann(3, 5), 42,438 calls, once per round.

// benchSize is the number of rounds. The vm subset of CX reads no arguments,
// so run.sh writes the size here before it runs or builds the program.
var benchSize i32 = 1

// benchZero is the 0 the other compiled forms read so no compiler folds a
// round, see README.md.
var benchZero i32 = 0

func fnv(h ui64, v ui64) (out ui64) {
	out = (h ^ v) * 1099511628211UL
}

func ackermann(m i32, n i32) (out i32) {
	if m == 0 {
		out = n + 1
	} else {
		if n == 0 {
			out = ackermann(m-1, 1)
		} else {
			out = ackermann(m-1, ackermann(m, n-1))
		}
	}
}

func run(size i32) (h ui64, ok bool) {
	global benchZero
	h = 14695981039346656037UL
	ok = true
	var r i32
	var round i32
	for round = 0; round < size; round++ {
		r = ackermann(3, 5+benchZero)
		h = fnv(h, i32.ui64(r))
		ok = ok && r == 253
	}
}

func main() {
	global benchSize
	var h1 ui64
	var h2 ui64
	var ok1 bool
	var ok2 bool
	h1, ok1 = run(benchSize)
	h2, ok2 = run(benchSize)
	ui64.print(h1)
	if ok1 && ok2 && h1 == h2 {
		printf("ackermann pass\n")
	} else {
		printf("ackermann FAIL\n")
	}
}
