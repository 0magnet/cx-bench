package main

// Bubble sorts a reversed [150]i32 once per round, 11175 swaps each.

// benchSize is the number of rounds. The vm subset of CX reads no arguments,
// so run.sh writes the size here before it runs or builds the program.
var benchSize i32 = 1

func fnv(h ui64, v ui64) (out ui64) {
	out = (h ^ v) * 1099511628211UL
}

func run(size i32) (h ui64, ok bool) {
	h = 14695981039346656037UL
	ok = true
	var nums [150]i32
	var i i32
	var j i32
	var t i32
	var swaps i32
	var round i32
	for round = 0; round < size; round++ {
		for i = 0; i < 150; i++ {
			nums[i] = 150 - i
		}
		swaps = 0
		for i = 0; i < 149; i++ {
			for j = 1; j < 150-i; j++ {
				if nums[j-1] > nums[j] {
					t = nums[j-1]
					nums[j-1] = nums[j]
					nums[j] = t
					swaps++
				}
			}
		}
		h = fnv(h, i32.ui64(swaps))
		ok = ok && swaps == 11175
	}
	for i = 0; i < 150; i++ {
		h = fnv(h, i32.ui64(nums[i]))
		ok = ok && (size == 0 || nums[i] == i+1)
	}
}

func main() {
	global benchSize
	var h1 ui64
	var h2 ui64
	var ok1 bool
	var ok2 bool
	h1, ok1 = run(benchSize)
	h2, ok2 = run(benchSize)
	ui64.print(h1)
	if ok1 && ok2 && h1 == h2 {
		printf("array pass\n")
	} else {
		printf("array FAIL\n")
	}
}
