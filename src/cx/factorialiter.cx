package main

// n! for n 0 to 20 with a loop once per round. 20! is the largest that fits
// a ui64.

// benchSize is the number of rounds. The vm subset of CX reads no arguments,
// so run.sh writes the size here before it runs or builds the program.
var benchSize i32 = 1

func fnv(h ui64, v ui64) (out ui64) {
	out = (h ^ v) * 1099511628211UL
}

func factorial(n ui64) (out ui64) {
	out = 1UL
	var k ui64
	for k = 2UL; k <= n; k++ {
		out = out * k
	}
}

func run(size i32) (h ui64, ok bool) {
	h = 14695981039346656037UL
	ok = true
	var f ui64
	var n ui64
	var round i32
	for round = 0; round < size; round++ {
		f = 0UL
		for n = 0UL; n <= 20UL; n++ {
			f = factorial(n)
			h = fnv(h, f)
		}
		ok = ok && f == 2432902008176640000UL
	}
}

func main() {
	global benchSize
	var h1 ui64
	var h2 ui64
	var ok1 bool
	var ok2 bool
	h1, ok1 = run(benchSize)
	h2, ok2 = run(benchSize)
	ui64.print(h1)
	if ok1 && ok2 && h1 == h2 {
		printf("factorialiter pass\n")
	} else {
		printf("factorialiter FAIL\n")
	}
}
